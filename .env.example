# Hugging Face write token. Create one at https://huggingface.co/settings/tokens
HF_TOKEN=hf_replace_with_your_write_token

# User or organization that will own the model repositories.
HF_REPO_NAMESPACE=your-huggingface-username

# Creates: <namespace>/<prefix>-sft, -dpo, and -grpo.
HF_REPO_PREFIX=ecfr-title12-llama31-8b

# Keep unpublished work private by default. Set to false for public repos.
HF_REPO_PRIVATE=true