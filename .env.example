# Hugging Face write token. Create one at https://huggingface.co/settings/tokens
HF_TOKEN=hf_replace_with_your_write_token

# User or organization that will own the model repositories.
HF_REPO_NAMESPACE=your-huggingface-username

# Creates: <namespace>/<prefix>-<cpt|sft|dpo|grpo>-<artifact fingerprint>.
# Phase 1 reads exported variables or `hf auth login`, not this file automatically.
HF_REPO_PREFIX=ecfr-title12-llama31-8b

# Keep unpublished work private by default. Set to false for public repos.
HF_REPO_PRIVATE=true

# Optional bearer token for exposing model_gateway.py through a secure HTTPS tunnel.
# Generate a long random value; configure the same secret in RegBench hosting.
REGBENCH_GATEWAY_TOKEN=replace_with_a_long_random_secret
